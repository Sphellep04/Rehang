NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Server only. Never prefix these with NEXT_PUBLIC_.
# Secret used to scramble ID numbers before they are stored. At least 32 random characters.
# Create one with: openssl rand -hex 32. Changing it later breaks duplicate-ID detection.
ID_HASH_PEPPER=
# Lets the daily clean-up job delete ID photos and lets account deletion close the sign-in. Find it in Supabase project settings, API.
SUPABASE_SERVICE_ROLE_KEY=
# Protects the /api/cron/* routes. At least 24 random characters. Vercel sends it automatically.
CRON_SECRET=

# Email through Resend (alerts and the daily digest). Create a key at resend.com and verify your sending domain.
RESEND_API_KEY=
# Shown as the sender, for example: Rehang <hello@yourdomain.com>. The domain must be verified in Resend.
EMAIL_FROM=
# Public address of the site, used in email links, for example https://rehang.na
NEXT_PUBLIC_SITE_URL=http://localhost:3000
